{
  "name": "techvera-backend",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "Arnab Dey",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm server.ts",
    "dev:watch": "nodemon --watch . --ext ts --ignore dist/ --exec \"node --loader ts-node/esm server.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "pretest:persistence": "npm run build",
    "test:persistence": "node --test tests/persistence.test.mjs",
    "typecheck": "tsc --noEmit",
    "pretest:smoke": "npm run build",
    "test:smoke": "node tests/server-smoke.mjs",
    "db:migrate": "node dist/database/migrate-cli.js",
    "pretest:schema": "npm run build",
    "test:schema": "node --test tests/schema.test.mjs",
    "ingestion": "node dist/ingestion/cli.js",
    "pretest:ingestion": "npm run build",
    "test:ingestion": "node --test tests/ingestion.test.mjs",
    "pretest:seed": "npm run build",
    "test:seed": "node tests/seed-publication.mjs",
    "corpus:seed-manifest": "node dist/ingestion/seedManifest.js"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.8",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "file-type": "^21.3.4",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=20.19.0 <21"
  }
}
