PORT=8000
# Groq powers everything: question generation, evaluation, resume analysis and Whisper transcription.
GROQ_API_KEY=your_groq_api_key_here
# Optional failover keys — auto-rotate on rate limits with per-key cooldowns.
# NOTE: Groq limits are per ACCOUNT (organization), so each extra key must come
# from a DIFFERENT Groq account to actually add quota.
GROQ_API_KEY_2=
GROQ_API_KEYS=key3,key4,key5
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MIN_CALL_INTERVAL=1

# Gemini — SIRF Resume Analyzer ka fallback (jab SAARI Groq keys rate-limit ho jayein)
# Free key yahan se banao: https://aistudio.google.com/apikey
# Voice (TTS/Whisper) + interview flows hamesha Groq pe hi rahenge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
REQUEST_TIMEOUT=60
INTERNAL_API_KEY=your_internal_api_key_here

# TTS voice for the AI interviewer
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Explicit callback origin; must match backend BACKEND_URL. Local HTTP needs development mode.
NODE_ENV=development
RESUME_CALLBACK_BASE_URL=http://localhost:5001

# Phase 5: prepared, hash-checked local model cache outside Git; never downloaded by HTTP.
EMBEDDING_MODEL_DIR=/absolute/path/outside-the-checkout/minilm-l3
